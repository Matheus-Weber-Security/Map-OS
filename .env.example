# Ambiente da Aplicação (development, testing, production)
CI_ENV=development

# URL Base da Aplicação (com barra final)
APP_URL=http://localhost:8000/

# Configurações do Banco de Dados (MySQL / TiDB Cloud / Docker)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=banco
DB_USER=root
DB_PASS=root
DB_DRIVER=mysqli

# Ativar SSL (Obrigatório como 'true' para conexões remotas como TiDB Cloud Serverless)
DB_SSL=false
DB_SSL_CA=
